# Mot de passe fort (12 caractères minimum, ne jamais le committer)
ADMIN_PASSWORD=
# Chaîne aléatoire de 32 caractères minimum : openssl rand -hex 32
SESSION_SECRET=
# Dossier persistant : contiendra les photos originales, dérivés et SQLite
DATA_DIR=./data
# Port écouté par adapter-node
PORT=3000
# Autorise les uploads (par défaut 512K dans certains environnements)
BODY_SIZE_LIMIT=120M
# Facultatif si FFmpeg et ffprobe sont déjà dans le PATH (Docker les inclut).
# Windows : chemins absolus vers les exécutables si nécessaire.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Import optionnel depuis Google Photos (API Google Photos Picker)
GOOGLE_PHOTOS_CLIENT_ID=
GOOGLE_PHOTOS_CLIENT_SECRET=
# À enregistrer également dans les URI de redirection autorisées du client OAuth
GOOGLE_PHOTOS_REDIRECT_URI=http://localhost:5173/admin/google-photos/callback
# Repli pour la date Google (en l'absence de date EXIF locale)
GOOGLE_PHOTOS_TIME_ZONE=Europe/Paris
